{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/1Step621/zerium/refs/heads/main/plugins/plugin.schema.json",
  "title": "Zerium plugin API",
  "$comment": "Structural tooling schema. Cross-reference, shader namespace, typed numeric, and total ABI budget invariants are enforced by Rust domain validation.",
  "x-zerium-property-abi-byte-budget": 8388608,
  "x-zerium-max-string-bytes": 4096,
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "id"],
  "anyOf": [
    { "properties": { "items": { "minItems": 1 } }, "required": ["items"] },
    { "properties": { "effects": { "minItems": 1 } }, "required": ["effects"] }
  ],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "$ref": "#/$defs/logicalId" },
    "items": { "type": "array", "items": { "$ref": "#/$defs/item" } },
    "effects": { "type": "array", "items": { "$ref": "#/$defs/effect" } },
    "api_version": { "const": 1 }
  },
  "$defs": {
    "localizedText": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "logicalId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "catalogCategory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/logicalId" },
        "label": { "$ref": "#/$defs/localizedText" }
      }
    },
    "wgslId": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "not": { "pattern": "^(?:_|__.*)$" }
    },
    "wgslSuffix": { "type": "string", "pattern": "^[A-Za-z0-9_]+$" },
    "shaderModule": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "not": { "pattern": "^(?:_|__.*|generated)$" }
    },
    "shader": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module"],
      "properties": {
        "module": { "$ref": "#/$defs/shaderModule" },
        "vertex_entry": { "$ref": "#/$defs/wgslId" },
        "fragment_entry": { "$ref": "#/$defs/wgslId" }
      }
    },
    "computeShader": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module"],
      "properties": {
        "module": { "$ref": "#/$defs/shaderModule" },
        "entry": { "$ref": "#/$defs/wgslId" }
      }
    },
    "mediaPlayback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_start",
        "source_duration",
        "playback_speed",
        "end_behavior"
      ],
      "properties": {
        "source_start": { "$ref": "#/$defs/wgslId" },
        "source_duration": { "$ref": "#/$defs/wgslId" },
        "playback_speed": { "$ref": "#/$defs/wgslId" },
        "end_behavior": { "$ref": "#/$defs/wgslId" }
      }
    },
    "audioCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "file",
        "reader",
        "volume",
        "preserve_pitch",
        "playback"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/logicalId" },
        "file": { "$ref": "#/$defs/wgslId" },
        "reader": { "$ref": "#/$defs/logicalId" },
        "volume": { "$ref": "#/$defs/wgslId" },
        "preserve_pitch": { "$ref": "#/$defs/wgslId" },
        "playback": { "$ref": "#/$defs/mediaPlayback" }
      }
    },
    "editorCapability": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "source_start",
            "source_duration",
            "playback_speed"
          ],
          "properties": {
            "type": { "const": "timeline" },
            "source_start": { "$ref": "#/$defs/wgslId" },
            "source_duration": { "$ref": "#/$defs/wgslId" },
            "playback_speed": { "$ref": "#/$defs/wgslId" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "property"],
          "properties": {
            "type": { "const": "position" },
            "property": { "$ref": "#/$defs/wgslId" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "property", "position"],
          "properties": {
            "type": { "const": "size" },
            "property": { "$ref": "#/$defs/wgslId" },
            "position": { "$ref": "#/$defs/wgslId" },
            "origin": { "$ref": "#/$defs/wgslId" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "property"],
          "properties": {
            "type": { "const": "aspect_lock" },
            "property": { "$ref": "#/$defs/wgslId" },
            "default": { "type": "boolean", "default": false }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "property", "position", "size"],
          "properties": {
            "type": { "const": "points" },
            "property": { "$ref": "#/$defs/wgslId" },
            "position": { "$ref": "#/$defs/wgslId" },
            "size": { "$ref": "#/$defs/wgslId" },
            "origin": { "$ref": "#/$defs/wgslId" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "points",
            "position",
            "size",
            "tension",
            "closed"
          ],
          "properties": {
            "type": { "const": "spline" },
            "points": { "$ref": "#/$defs/wgslId" },
            "position": { "$ref": "#/$defs/wgslId" },
            "size": { "$ref": "#/$defs/wgslId" },
            "origin": { "$ref": "#/$defs/wgslId" },
            "tension": { "$ref": "#/$defs/wgslId" },
            "closed": { "$ref": "#/$defs/wgslId" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "property"],
          "properties": {
            "type": { "const": "label" },
            "property": { "$ref": "#/$defs/wgslId" }
          }
        }
      ]
    },
    "editorCapabilities": {
      "type": "array",
      "items": { "$ref": "#/$defs/editorCapability" },
      "allOf": [
        {
          "contains": {
            "properties": { "type": { "const": "timeline" } },
            "required": ["type"]
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": { "type": { "const": "position" } },
            "required": ["type"]
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": { "type": { "const": "size" } },
            "required": ["type"]
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": { "type": { "const": "aspect_lock" } },
            "required": ["type"]
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": { "type": { "const": "label" } },
            "required": ["type"]
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": { "type": { "const": "points" } },
            "required": ["type"]
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": { "type": { "const": "spline" } },
            "required": ["type"]
          },
          "minContains": 0,
          "maxContains": 1
        }
      ]
    },
    "property": {
      "allOf": [
        {
          "type": "object",
          "required": ["id", "label"],
          "properties": {
            "id": { "$ref": "#/$defs/wgslId" },
            "label": { "$ref": "#/$defs/localizedText" }
          }
        },
        { "oneOf": [{ "$ref": "#/$defs/value" }, { "$ref": "#/$defs/array" }] }
      ],
      "unevaluatedProperties": false
    },
    "outputBounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": {
          "type": "array",
          "prefixItems": [
            { "type": "string", "minLength": 1 },
            { "type": "string", "minLength": 1 }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "max": {
          "type": "array",
          "prefixItems": [
            { "type": "string", "minLength": 1 },
            { "type": "string", "minLength": 1 }
          ],
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "if": { "required": ["render"] },
      "then": { "properties": { "id": { "$ref": "#/$defs/wgslId" } } },
      "required": ["id", "label", "category", "symbol"],
      "properties": {
        "id": { "$ref": "#/$defs/logicalId" },
        "label": { "$ref": "#/$defs/localizedText" },
        "category": { "$ref": "#/$defs/catalogCategory" },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "symbol": { "type": "string", "minLength": 1 },
        "audio": {
          "type": "array",
          "items": { "$ref": "#/$defs/audioCapability" }
        },
        "editor": { "$ref": "#/$defs/editorCapabilities" },
        "properties": {
          "type": "array",
          "items": { "$ref": "#/$defs/property" }
        },
        "render": { "$ref": "#/$defs/itemRender" }
      }
    },
    "passConstant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "value"],
      "properties": {
        "id": { "$ref": "#/$defs/wgslId" },
        "value": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["f32"],
              "properties": { "f32": { "type": "number" } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["i32"],
              "properties": {
                "i32": {
                  "type": "integer",
                  "minimum": -2147483648,
                  "maximum": 2147483647
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["u32"],
              "properties": {
                "u32": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["bool"],
              "properties": { "bool": { "type": "boolean" } }
            }
          ]
        }
      }
    },
    "renderPass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "shader"],
      "properties": {
        "type": { "const": "render" },
        "shader": { "$ref": "#/$defs/shader" },
        "constants": {
          "type": "array",
          "items": { "$ref": "#/$defs/passConstant" }
        }
      }
    },
    "computePass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "shader"],
      "properties": {
        "type": { "const": "compute" },
        "shader": { "$ref": "#/$defs/computeShader" },
        "dispatch": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            { "$ref": "#/$defs/dispatchDimension" },
            { "$ref": "#/$defs/dispatchDimension" },
            { "$ref": "#/$defs/dispatchDimension" }
          ]
        },
        "constants": {
          "type": "array",
          "items": { "$ref": "#/$defs/passConstant" }
        }
      }
    },
    "dispatchDimension": {
      "enum": ["width", "height", "max_dimension", "one"]
    },
    "temporalPass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "sampling", "reducer"],
      "properties": {
        "type": { "const": "temporal" },
        "sampling": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "sample_count",
                "start_offset",
                "end_offset"
              ],
              "properties": {
                "type": { "const": "range" },
                "sample_count": { "$ref": "#/$defs/wgslId" },
                "start_offset": { "$ref": "#/$defs/wgslId" },
                "end_offset": { "$ref": "#/$defs/wgslId" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "offsets"],
              "properties": {
                "type": { "const": "offsets" },
                "offsets": { "$ref": "#/$defs/wgslId" }
              }
            }
          ]
        },
        "reducer": { "$ref": "#/$defs/shader" },
        "constants": {
          "type": "array",
          "items": { "$ref": "#/$defs/passConstant" }
        }
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "category", "properties", "render"],
      "properties": {
        "id": {
          "allOf": [
            { "$ref": "#/$defs/logicalId" },
            { "$ref": "#/$defs/wgslId" }
          ]
        },
        "label": { "$ref": "#/$defs/localizedText" },
        "category": { "$ref": "#/$defs/catalogCategory" },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "editor": {
          "$ref": "#/$defs/editorCapabilities",
          "not": {
            "contains": {
              "properties": { "type": { "enum": ["timeline", "label"] } },
              "required": ["type"]
            }
          }
        },
        "properties": {
          "type": "array",
          "items": { "$ref": "#/$defs/property" }
        },
        "render": { "$ref": "#/$defs/effectRender" }
      }
    },
    "propertyConstraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "min": { "type": "number" }, "max": { "type": "number" } }
    },
    "scalarUi": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": { "$ref": "#/$defs/localizedText" },
        "unit": { "type": "string" },
        "step": { "type": "number", "exclusiveMinimum": 0 },
        "drag_step": { "type": "number", "exclusiveMinimum": 0 },
        "visible": { "type": "boolean" },
        "multiline": { "type": "boolean" },
        "editor": { "enum": ["font_family"] },
        "extensions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9]+$" }
        }
      }
    },
    "textStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "size",
        "font_family",
        "font_size",
        "color",
        "outline_width",
        "outline_color",
        "bold",
        "italic",
        "horizontal_alignment",
        "vertical_alignment"
      ],
      "properties": {
        "size": { "$ref": "#/$defs/wgslId" },
        "font_family": { "$ref": "#/$defs/wgslId" },
        "font_size": { "$ref": "#/$defs/wgslId" },
        "color": { "$ref": "#/$defs/wgslId" },
        "outline_width": { "$ref": "#/$defs/wgslId" },
        "outline_color": { "$ref": "#/$defs/wgslId" },
        "bold": { "$ref": "#/$defs/wgslId" },
        "italic": { "$ref": "#/$defs/wgslId" },
        "horizontal_alignment": { "$ref": "#/$defs/wgslId" },
        "vertical_alignment": { "$ref": "#/$defs/wgslId" }
      }
    },
    "enumVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value"],
      "properties": {
        "value": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "label": { "$ref": "#/$defs/localizedText" }
      }
    },
    "scalar": {
      "allOf": [
        { "$ref": "#/$defs/scalarSettings" },
        {
          "oneOf": [
            {
              "type": "object",
              "required": ["type", "default"],
              "properties": {
                "type": { "const": "f32" },
                "default": {
                  "type": "number",
                  "minimum": -3.4028234663852886e38,
                  "maximum": 3.4028234663852886e38
                }
              }
            },
            {
              "type": "object",
              "required": ["type", "default"],
              "properties": {
                "type": { "const": "i32" },
                "default": {
                  "type": "integer",
                  "minimum": -2147483648,
                  "maximum": 2147483647
                }
              }
            },
            {
              "type": "object",
              "required": ["type", "default"],
              "properties": {
                "type": { "const": "u32" },
                "default": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295
                }
              }
            },
            {
              "type": "object",
              "required": ["type", "default", "variants"],
              "properties": {
                "type": { "const": "enum" },
                "default": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295
                },
                "variants": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "$ref": "#/$defs/enumVariant" }
                }
              }
            },
            {
              "type": "object",
              "required": ["type", "default"],
              "properties": {
                "type": { "const": "bool" },
                "default": { "type": "boolean" }
              }
            },
            {
              "type": "object",
              "required": ["type", "default"],
              "properties": {
                "type": { "const": "color" },
                "default": {
                  "type": "array",
                  "minItems": 4,
                  "maxItems": 4,
                  "items": {
                    "type": "number",
                    "minimum": -3.4028234663852886e38,
                    "maximum": 3.4028234663852886e38
                  }
                }
              }
            },
            {
              "type": "object",
              "required": ["type", "default"],
              "properties": {
                "type": { "const": "string" },
                "default": { "type": "string" }
              }
            },
            {
              "type": "object",
              "required": ["type", "default"],
              "properties": {
                "type": { "const": "file" },
                "default": { "type": ["string", "null"], "minLength": 1 }
              }
            }
          ]
        }
      ]
    },
    "tuple": {
      "type": "object",
      "required": ["type", "elements"],
      "properties": {
        "type": { "const": "tuple" },
        "elements": {
          "type": "array",
          "minItems": 2,
          "maxItems": 64,
          "items": {
            "allOf": [{ "$ref": "#/$defs/scalar" }],
            "unevaluatedProperties": false
          }
        }
      }
    },
    "value": {
      "oneOf": [{ "$ref": "#/$defs/scalar" }, { "$ref": "#/$defs/tuple" }]
    },
    "textureInput": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "id", "file", "reader"],
          "properties": {
            "type": { "const": "media" },
            "id": { "$ref": "#/$defs/wgslId" },
            "playback": { "$ref": "#/$defs/mediaPlayback" },
            "placement": {
              "type": "object",
              "additionalProperties": false,
              "required": ["position", "size"],
              "properties": {
                "position": { "$ref": "#/$defs/wgslId" },
                "size": { "$ref": "#/$defs/wgslId" },
                "origin": { "$ref": "#/$defs/wgslId" }
              }
            },
            "file": { "$ref": "#/$defs/wgslId" },
            "reader": { "$ref": "#/$defs/logicalId" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "id", "text", "style"],
          "properties": {
            "type": { "const": "text" },
            "id": { "$ref": "#/$defs/wgslId" },
            "text": { "$ref": "#/$defs/wgslId" },
            "style": { "$ref": "#/$defs/textStyle" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "id", "value", "decimal_places", "style"],
          "properties": {
            "type": { "const": "number" },
            "id": { "$ref": "#/$defs/wgslId" },
            "value": { "$ref": "#/$defs/wgslId" },
            "decimal_places": { "$ref": "#/$defs/wgslId" },
            "style": { "$ref": "#/$defs/textStyle" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "id",
            "start_offset",
            "end_offset",
            "hide_original"
          ],
          "properties": {
            "type": { "const": "render_result" },
            "start_offset": { "$ref": "#/$defs/wgslId" },
            "end_offset": { "$ref": "#/$defs/wgslId" },
            "hide_original": { "$ref": "#/$defs/wgslId" },
            "id": { "$ref": "#/$defs/wgslId" }
          }
        }
      ]
    },
    "textureInputs": {
      "type": "array",
      "maxItems": 8,
      "items": { "$ref": "#/$defs/textureInput" }
    },
    "itemRender": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shader", "bounds"],
      "properties": {
        "shader": { "$ref": "#/$defs/shader" },
        "vertex_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295,
          "default": 6
        },
        "bounds": { "$ref": "#/$defs/outputBounds" },
        "inputs": { "$ref": "#/$defs/textureInputs" }
      }
    },
    "effectRender": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bounds", "passes"],
      "properties": {
        "scale": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4,
          "default": 1
        },
        "input_space": { "enum": ["output", "source"], "default": "output" },
        "bounds": { "$ref": "#/$defs/outputBounds" },
        "inputs": { "$ref": "#/$defs/textureInputs" },
        "passes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/renderPass" },
              { "$ref": "#/$defs/computePass" },
              { "$ref": "#/$defs/temporalPass" }
            ]
          }
        }
      }
    },
    "scalarSettings": {
      "type": "object",
      "properties": {
        "scene_bindable": { "type": "boolean", "default": true },
        "editable": { "type": "boolean", "default": true },
        "animatable": { "type": "boolean", "default": false },
        "constraints": { "$ref": "#/$defs/propertyConstraints" },
        "ui": { "$ref": "#/$defs/scalarUi" }
      }
    },
    "array": {
      "type": "object",
      "required": ["type", "element", "max_items", "default"],
      "properties": {
        "type": { "const": "array" },
        "element": {
          "allOf": [{ "$ref": "#/$defs/value" }],
          "unevaluatedProperties": false
        },
        "min_items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000,
          "default": 0
        },
        "max_items": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "default": { "type": "array" }
      }
    }
  }
}
