{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/1Step621/zerium/refs/heads/main/plugins/plugin.schema.json",
  "title": "Zerium plugin API",
  "$comment": "Structural tooling schema. Cross-reference, shader namespace, typed numeric, and total ABI budget invariants are enforced by Rust domain validation.",
  "x-zerium-property-abi-byte-budget": 8388608,
  "x-zerium-max-string-bytes": 4096,
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "id"],
  "anyOf": [
    { "properties": { "items": { "minItems": 1 } }, "required": ["items"] },
    { "properties": { "effects": { "minItems": 1 } }, "required": ["effects"] }
  ],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "$ref": "#/$defs/logicalId" },
    "items": { "type": "array", "items": { "$ref": "#/$defs/item" } },
    "effects": { "type": "array", "items": { "$ref": "#/$defs/effect" } },
    "api_version": { "const": 1 }
  },
  "$defs": {
    "localizedText": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "logicalId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "catalogCategory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/logicalId" },
        "label": { "$ref": "#/$defs/localizedText" }
      }
    },
    "wgslId": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "not": { "pattern": "^(?:_|__.*)$" }
    },
    "wgslSuffix": { "type": "string", "pattern": "^[A-Za-z0-9_]+$" },
    "shaderModule": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "not": { "pattern": "^(?:_|__.*|generated)$" }
    },
    "shader": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module"],
      "properties": {
        "module": { "$ref": "#/$defs/shaderModule" },
        "vertex_entry": { "$ref": "#/$defs/wgslId" },
        "fragment_entry": { "$ref": "#/$defs/wgslId" }
      }
    },
    "computeShader": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module"],
      "properties": {
        "module": { "$ref": "#/$defs/shaderModule" },
        "entry": { "$ref": "#/$defs/wgslId" }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "extensions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+$"}}
      }
    },
    "mediaPlayback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_start", "source_duration", "playback_speed", "end_behavior"],
      "properties": {
        "source_start": { "$ref": "#/$defs/wgslId" },
        "source_duration": { "$ref": "#/$defs/wgslId" },
        "playback_speed": { "$ref": "#/$defs/wgslId" },
        "end_behavior": { "$ref": "#/$defs/wgslId" }
      }
    },
    "audioCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "file",
        "reader",
        "volume",
        "source_start",
        "source_duration",
        "playback_speed",
        "end_behavior",
        "preserve_pitch"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/logicalId" },
        "file": { "$ref": "#/$defs/wgslId" },
        "reader": { "$ref": "#/$defs/logicalId" },
        "volume": {"$ref": "#/$defs/wgslId"},
        "source_start": {"$ref": "#/$defs/wgslId"},
        "source_duration": {"$ref": "#/$defs/wgslId"},
        "playback_speed": {"$ref": "#/$defs/wgslId"},
        "end_behavior": {"$ref": "#/$defs/wgslId"},
        "preserve_pitch": {"$ref": "#/$defs/wgslId"}
      }
    },
    "editorCapability": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "source_start", "source_duration", "playback_speed"],
          "properties": {
            "type": {"const": "timeline"},
            "source_start": {"$ref": "#/$defs/wgslId"},
            "source_duration": {"$ref": "#/$defs/wgslId"},
            "playback_speed": {"$ref": "#/$defs/wgslId"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "property"],
          "properties": {
            "type": {"const": "position"},
            "property": {"$ref": "#/$defs/wgslId"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "property", "position"],
          "properties": {
            "type": {"const": "size"},
            "property": {"$ref": "#/$defs/wgslId"},
            "position": {"$ref": "#/$defs/wgslId"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "property"],
          "properties": {
            "type": {"const": "aspect_lock"},
            "property": {"$ref": "#/$defs/wgslId"},
            "default": {"type": "boolean", "default": false}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "property", "position", "size"],
          "properties": {
            "type": {"const": "points"},
            "property": {"$ref": "#/$defs/wgslId"},
            "position": {"$ref": "#/$defs/wgslId"},
            "size": {"$ref": "#/$defs/wgslId"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "points", "position", "size", "tension", "closed"],
          "properties": {
            "type": {"const": "spline"},
            "points": {"$ref": "#/$defs/wgslId"},
            "position": {"$ref": "#/$defs/wgslId"},
            "size": {"$ref": "#/$defs/wgslId"},
            "tension": {"$ref": "#/$defs/wgslId"},
            "closed": {"$ref": "#/$defs/wgslId"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "property"],
          "properties": {
            "type": {"const": "label"},
            "property": {"$ref": "#/$defs/wgslId"}
          }
        }
      ]
    },
    "editorCapabilities": {
      "type": "array",
      "items": { "$ref": "#/$defs/editorCapability" },
      "allOf": [
        {"contains": {"properties": {"type": {"const": "timeline"}}, "required": ["type"]}, "minContains": 0, "maxContains": 1},
        {"contains": {"properties": {"type": {"const": "position"}}, "required": ["type"]}, "minContains": 0, "maxContains": 1},
        {"contains": {"properties": {"type": {"const": "size"}}, "required": ["type"]}, "minContains": 0, "maxContains": 1},
        {"contains": {"properties": {"type": {"const": "aspect_lock"}}, "required": ["type"]}, "minContains": 0, "maxContains": 1},
        {"contains": {"properties": {"type": {"const": "label"}}, "required": ["type"]}, "minContains": 0, "maxContains": 1},
        {"contains": {"properties": {"type": {"const": "points"}}, "required": ["type"]}, "minContains": 0, "maxContains": 1},
        {"contains": {"properties": {"type": {"const": "spline"}}, "required": ["type"]}, "minContains": 0, "maxContains": 1}
      ]
    },
    "scalarType": {
      "oneOf": [
        { "enum": ["f32", "i32", "u32", "bool", "color", "string"] },
        { "$ref": "#/$defs/enumType" }
      ]
    },
    "tupleType": {
      "type": "array",
      "minItems": 2,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/scalarType" }
    },
    "arrayValueType": {
      "oneOf": [
        { "$ref": "#/$defs/scalarType" },
        { "$ref": "#/$defs/tupleType" }
      ]
    },
    "enumType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enum"],
      "properties": {
        "enum": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
        }
      }
    },
    "propertyType": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["value"],
          "properties": {"value": {"$ref": "#/$defs/arrayValueType"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["array"],
          "properties": {
            "array": {
              "type": "object",
              "additionalProperties": false,
              "required": ["element_type", "max_items"],
              "properties": {
                "element_type": {"$ref": "#/$defs/arrayValueType"},
                "min_items": {"type": "integer", "minimum": 0, "maximum": 1000000},
                "max_items": {"type": "integer", "minimum": 1, "maximum": 1000000}
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["file"],
          "properties": {"file": {"$ref": "#/$defs/file"}}
        }
      ]
    },
    "property": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "type", "default", "configurations"],
      "if": {"properties": {"type": {"required": ["array"]}}},
      "then": {"required": ["append_default"]},
      "else": {"not": {"required": ["append_default"]}},
      "properties": {
        "id": {"$ref": "#/$defs/wgslId"},
        "label": {"$ref": "#/$defs/localizedText"},
        "type": {"$ref": "#/$defs/propertyType"},
        "default": {"$ref": "#/$defs/propertyValue"},
        "append_default": {"$ref": "#/$defs/propertyValue"},
        "configurations": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/configuration"}}
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"required": ["file"]}}},
          "then": {
            "properties": {
              "default": {"const": {"file": null}},
              "configurations": {
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "properties": {"scene_bindable": {"const": false}, "animatable": {"const": false}},
                  "required": ["scene_bindable"]
                }
              }
            }
          }
        }
      ]
    },
    "outputBounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": {
          "type": "array",
          "prefixItems": [
            { "type": "string", "minLength": 1 },
            { "type": "string", "minLength": 1 }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "max": {
          "type": "array",
          "prefixItems": [
            { "type": "string", "minLength": 1 },
            { "type": "string", "minLength": 1 }
          ],
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "if": { "required": ["shader"] },
      "then": { "properties": { "id": { "$ref": "#/$defs/wgslId" } } },
      "required": [
        "id",
        "label",
        "category",
        "symbol",
        "capabilities",
        "output_bounds"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/logicalId" },
        "label": { "$ref": "#/$defs/localizedText" },
        "category": { "$ref": "#/$defs/catalogCategory" },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "symbol": { "type": "string", "minLength": 1 },
        "capabilities": { "$ref": "#/$defs/capabilities" },
        "audio": { "type": "array", "items": { "$ref": "#/$defs/audioCapability" } },
        "editor": { "$ref": "#/$defs/editorCapabilities" },
        "output_bounds": { "$ref": "#/$defs/outputBounds" },
        "properties": {
          "type": "array",
          "items": { "$ref": "#/$defs/property" }
        },
        "shader": { "$ref": "#/$defs/shader" },
        "vertex_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        }
      }
    },
    "passConstant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "value"],
      "properties": {
        "id": { "$ref": "#/$defs/wgslId" },
        "value": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["f32"],
              "properties": { "f32": { "type": "number" } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["i32"],
              "properties": {
                "i32": {
                  "type": "integer",
                  "minimum": -2147483648,
                  "maximum": 2147483647
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["u32"],
              "properties": {
                "u32": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["bool"],
              "properties": { "bool": { "type": "boolean" } }
            }
          ]
        }
      }
    },
    "renderPass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "shader"],
      "properties": {
        "type": { "const": "render" },
        "shader": { "$ref": "#/$defs/shader" },
        "constants": {
          "type": "array",
          "items": { "$ref": "#/$defs/passConstant" }
        }
      }
    },
    "computePass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "shader"],
      "properties": {
        "type": { "const": "compute" },
        "shader": { "$ref": "#/$defs/computeShader" },
        "dispatch": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            { "$ref": "#/$defs/dispatchDimension" },
            { "$ref": "#/$defs/dispatchDimension" },
            { "$ref": "#/$defs/dispatchDimension" }
          ]
        },
        "constants": {
          "type": "array",
          "items": { "$ref": "#/$defs/passConstant" }
        }
      }
    },
    "dispatchDimension": {
      "enum": ["width", "height", "max_dimension", "one"]
    },
    "temporalPass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "sampling", "reducer"],
      "properties": {
        "type": { "const": "temporal" },
        "sampling": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "sample_count",
                "start_offset",
                "end_offset"
              ],
              "properties": {
                "type": { "const": "range" },
                "sample_count": { "$ref": "#/$defs/wgslId" },
                "start_offset": { "$ref": "#/$defs/wgslId" },
                "end_offset": { "$ref": "#/$defs/wgslId" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "offsets"],
              "properties": {
                "type": { "const": "offsets" },
                "offsets": { "$ref": "#/$defs/wgslId" }
              }
            }
          ]
        },
        "reducer": { "$ref": "#/$defs/shader" },
        "constants": {
          "type": "array",
          "items": { "$ref": "#/$defs/passConstant" }
        }
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "category",
        "properties",
        "passes",
        "output_bounds"
      ],
      "properties": {
        "id": { "allOf": [{ "$ref": "#/$defs/logicalId" }, { "$ref": "#/$defs/wgslId" }] },
        "label": { "$ref": "#/$defs/localizedText" },
        "category": { "$ref": "#/$defs/catalogCategory" },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "render_scale": { "type": "integer", "minimum": 1, "maximum": 4 },
        "output_bounds": { "$ref": "#/$defs/outputBounds" },
        "input_space": { "enum": ["output", "source"] },
        "editor": { "$ref": "#/$defs/editorCapabilities", "not": { "contains": { "properties": { "type": { "enum": ["timeline", "label"] } }, "required": ["type"] } } },
        "capabilities": { "$ref": "#/$defs/capabilities" },
        "properties": {
          "type": "array",
          "items": { "$ref": "#/$defs/property" }
        },
        "passes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/renderPass" },
              { "$ref": "#/$defs/computePass" },
              { "$ref": "#/$defs/temporalPass" }
            ]
          }
        }
      }
    },
    "fixedScalarType": {
      "oneOf": [
        { "enum": ["f32", "i32", "u32", "bool", "color"] },
        { "$ref": "#/$defs/enumType" }
      ]
    },
    "numericConstraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "min": { "type": "number" }, "max": { "type": "number" } }
    },
    "scalarUi": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": { "$ref": "#/$defs/localizedText" },
        "unit": { "type": "string" },
        "step": { "type": "number", "exclusiveMinimum": 0 },
        "drag_step": { "type": "number", "exclusiveMinimum": 0 },
        "visible": { "type": "boolean" },
        "multiline": { "type": "boolean" },
        "editor": { "enum": ["font_family"] },
        "enum_variants": {
          "type": "object",
          "minProperties": 1,
          "patternProperties": {
            "^[0-9]+$": { "$ref": "#/$defs/localizedText" }
          },
          "additionalProperties": false
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scene_bindable": { "type": "boolean", "default": true },
        "editable": { "type": "boolean", "default": true },
        "animatable": { "type": "boolean", "default": false },
        "constraints": { "$ref": "#/$defs/numericConstraints" },
        "ui": { "$ref": "#/$defs/scalarUi" }
      }
    },
    "propertyValue": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "propertyNames": {"enum": ["f32", "i32", "u32", "enum", "bool", "tuple", "color", "string", "array", "file"]},
      "properties": {"file": {"type": "null"}}
    },
    "capability": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "id", "file", "reader"],
          "properties": {
            "type": {"const": "media"},
            "id": {"$ref": "#/$defs/wgslId"},
            "playback": {"$ref": "#/$defs/mediaPlayback"},
            "placement": {
              "type": "object",
              "additionalProperties": false,
              "required": ["position", "size"],
              "properties": {"position": {"$ref": "#/$defs/wgslId"}, "size": {"$ref": "#/$defs/wgslId"}}
            },
            "file": {"$ref": "#/$defs/wgslId"},
            "reader": {"$ref": "#/$defs/logicalId"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "id",
            "size",
            "text",
            "font_family",
            "font_size",
            "color",
            "outline_width",
            "outline_color",
            "bold",
            "italic",
            "horizontal_alignment",
            "vertical_alignment"
          ],
          "properties": {
            "type": {"const": "text"},
            "size": {"$ref": "#/$defs/wgslId"},
            "text": {"$ref": "#/$defs/wgslId"},
            "font_family": {"$ref": "#/$defs/wgslId"},
            "font_size": {"$ref": "#/$defs/wgslId"},
            "color": {"$ref": "#/$defs/wgslId"},
            "outline_width": {"$ref": "#/$defs/wgslId"},
            "outline_color": {"$ref": "#/$defs/wgslId"},
            "bold": {"$ref": "#/$defs/wgslId"},
            "italic": {"$ref": "#/$defs/wgslId"},
            "horizontal_alignment": {"$ref": "#/$defs/wgslId"},
            "vertical_alignment": {"$ref": "#/$defs/wgslId"},
            "id": {"$ref": "#/$defs/wgslId"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "id", "start_offset", "end_offset", "hide_original"],
          "properties": {
            "type": {"const": "render_result"},
            "start_offset": {"$ref": "#/$defs/wgslId"},
            "end_offset": {"$ref": "#/$defs/wgslId"},
            "hide_original": {"$ref": "#/$defs/wgslId"},
            "id": {"$ref": "#/$defs/wgslId"}
          }
        }
      ]
    },
    "capabilities": {
      "type": "array",
      "maxItems": 8,
      "items": { "$ref": "#/$defs/capability" }
    }
  }
}
