{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/1Step621/zerium/refs/heads/main/plugins/plugin.schema.json",
  "title": "Zerium plugin API",
  "$comment": "Structural tooling schema. Cross-reference, shader namespace, typed numeric, and total ABI budget invariants are enforced by Rust domain validation.",
  "x-zerium-property-abi-byte-budget": 8388608,
  "x-zerium-max-string-bytes": 4096,
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "id"],
  "anyOf": [
    {
      "properties": {
        "items": {
          "minItems": 1
        }
      },
      "required": ["items"]
    },
    {
      "properties": {
        "effects": {
          "minItems": 1
        }
      },
      "required": ["effects"]
    }
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "$ref": "#/$defs/logicalId"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "effects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/effect"
      }
    },
    "api_version": {
      "const": 1
    }
  },
  "$defs": {
    "logicalId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "wgslId": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "not": {
        "pattern": "^(?:_|__.*)$"
      }
    },
    "wgslSuffix": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_]+$"
    },
    "shaderSource": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9_-][A-Za-z0-9._-]*/)*[A-Za-z0-9_-][A-Za-z0-9._-]*\\.wesl$"
    },
    "shader": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": {
          "$ref": "#/$defs/shaderSource"
        },
        "vertex_entry": {
          "$ref": "#/$defs/wgslId"
        },
        "fragment_entry": {
          "$ref": "#/$defs/wgslId"
        }
      }
    },
    "computeShader": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": {
          "$ref": "#/$defs/shaderSource"
        },
        "entry": {
          "$ref": "#/$defs/wgslId"
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "media_type", "reader"],
      "properties": {
        "id": {
          "allOf": [
            {
              "$ref": "#/$defs/wgslSuffix"
            },
            {
              "not": {
                "enum": ["inputs", "sampler"]
              }
            }
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "media_type": {
          "enum": ["video", "audio", "image"]
        },
        "reader": {
          "$ref": "#/$defs/logicalId"
        },
        "extensions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+$"
          }
        }
      }
    },
    "visual": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "shader"],
          "properties": {
            "type": {
              "enum": ["procedural", "media"]
            },
            "shader": {
              "$ref": "#/$defs/shader"
            },
            "vertex_count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "shader",
            "size",
            "text",
            "font_family",
            "font_size",
            "color",
            "outline_width",
            "outline_color",
            "bold",
            "italic",
            "horizontal_alignment",
            "vertical_alignment"
          ],
          "properties": {
            "type": {
              "const": "text"
            },
            "shader": {
              "$ref": "#/$defs/shader"
            },
            "vertex_count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295
            },
            "size": {
              "$ref": "#/$defs/wgslId"
            },
            "text": {
              "$ref": "#/$defs/wgslId"
            },
            "font_family": {
              "$ref": "#/$defs/wgslId"
            },
            "font_size": {
              "$ref": "#/$defs/wgslId"
            },
            "color": {
              "$ref": "#/$defs/wgslId"
            },
            "outline_width": {
              "$ref": "#/$defs/wgslId"
            },
            "outline_color": {
              "$ref": "#/$defs/wgslId"
            },
            "bold": {
              "$ref": "#/$defs/wgslId"
            },
            "italic": {
              "$ref": "#/$defs/wgslId"
            },
            "horizontal_alignment": {
              "$ref": "#/$defs/wgslId"
            },
            "vertical_alignment": {
              "$ref": "#/$defs/wgslId"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "shader",
            "start_offset",
            "end_offset",
            "hide_original"
          ],
          "properties": {
            "type": {
              "const": "render_result"
            },
            "shader": {
              "$ref": "#/$defs/shader"
            },
            "vertex_count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295
            },
            "start_offset": {
              "$ref": "#/$defs/wgslId"
            },
            "end_offset": {
              "$ref": "#/$defs/wgslId"
            },
            "hide_original": {
              "$ref": "#/$defs/wgslId"
            }
          }
        }
      ]
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file"
          }
        },
        "visual": {
          "$ref": "#/$defs/visual"
        },
        "audio": {
          "type": "object",
          "additionalProperties": false,
          "required": ["inputs", "volume"],
          "properties": {
            "inputs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/wgslSuffix"
              }
            },
            "volume": {
              "$ref": "#/$defs/wgslId"
            }
          }
        },
        "editor": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "position": {
              "$ref": "#/$defs/wgslId"
            },
            "size": {
              "$ref": "#/$defs/wgslId"
            },
            "points": {
              "$ref": "#/$defs/wgslId"
            },
            "label": {
              "$ref": "#/$defs/wgslId"
            }
          }
        }
      }
    },
    "scalarType": {
      "oneOf": [
        {
          "enum": ["f32", "i32", "u32", "bool", "color", "string"]
        },
        {
          "$ref": "#/$defs/enumType"
        }
      ]
    },
    "tupleType": {
      "type": "array",
      "minItems": 2,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/scalarType"
      }
    },
    "arrayValueType": {
      "oneOf": [
        {
          "$ref": "#/$defs/scalarType"
        },
        {
          "$ref": "#/$defs/tupleType"
        }
      ]
    },
    "enumType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enum"],
      "properties": {
        "enum": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          }
        }
      }
    },
    "propertyType": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["value"],
          "properties": {
            "value": {
              "$ref": "#/$defs/arrayValueType"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["array"],
          "properties": {
            "array": {
              "type": "object",
              "additionalProperties": false,
              "required": ["element_type", "max_items"],
              "properties": {
                "element_type": {
                  "$ref": "#/$defs/arrayValueType"
                },
                "min_items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000
                },
                "max_items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000
                }
              }
            }
          }
        }
      ]
    },
    "property": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "type", "default", "configurations"],
      "properties": {
        "id": {
          "$ref": "#/$defs/wgslId"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "$ref": "#/$defs/propertyType"
        },
        "default": {
          "$ref": "#/$defs/propertyValue"
        },
        "configurations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/configuration"
          }
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "category", "symbol", "capabilities"],
      "properties": {
        "id": {
          "$ref": "#/$defs/logicalId"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "capabilities": {
          "$ref": "#/$defs/capabilities"
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/property"
          }
        }
      }
    },
    "passConstant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "value"],
      "properties": {
        "id": {
          "$ref": "#/$defs/wgslId"
        },
        "value": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["f32"],
              "properties": { "f32": { "type": "number" } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["i32"],
              "properties": {
                "i32": {
                  "type": "integer",
                  "minimum": -2147483648,
                  "maximum": 2147483647
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["u32"],
              "properties": {
                "u32": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["bool"],
              "properties": { "bool": { "type": "boolean" } }
            }
          ]
        }
      }
    },
    "renderPass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "shader"],
      "properties": {
        "type": {
          "const": "render"
        },
        "shader": {
          "$ref": "#/$defs/shader"
        },
        "constants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/passConstant"
          }
        }
      }
    },
    "computePass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "shader"],
      "properties": {
        "type": {
          "const": "compute"
        },
        "shader": {
          "$ref": "#/$defs/computeShader"
        },
        "dispatch": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {
              "$ref": "#/$defs/dispatchDimension"
            },
            {
              "$ref": "#/$defs/dispatchDimension"
            },
            {
              "$ref": "#/$defs/dispatchDimension"
            }
          ]
        },
        "constants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/passConstant"
          }
        }
      }
    },
    "dispatchDimension": {
      "enum": ["width", "height", "max_dimension", "one"]
    },
    "temporalPass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "sampling", "reducer"],
      "properties": {
        "type": {
          "const": "temporal"
        },
        "sampling": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sample_count", "angle"],
          "properties": {
            "sample_count": {
              "$ref": "#/$defs/wgslId"
            },
            "angle": {
              "$ref": "#/$defs/wgslId"
            },
            "phase": {
              "$ref": "#/$defs/wgslId"
            }
          }
        },
        "reducer": {
          "$ref": "#/$defs/shader"
        },
        "constants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/passConstant"
          }
        }
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "category", "properties", "passes"],
      "properties": {
        "id": {
          "$ref": "#/$defs/logicalId"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "render_scale": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/property"
          }
        },
        "passes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/renderPass"
              },
              {
                "$ref": "#/$defs/computePass"
              },
              {
                "$ref": "#/$defs/temporalPass"
              }
            ]
          }
        }
      }
    },
    "fixedScalarType": {
      "oneOf": [
        {
          "enum": ["f32", "i32", "u32", "bool", "color"]
        },
        {
          "$ref": "#/$defs/enumType"
        }
      ]
    },
    "numericConstraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      }
    },
    "scalarUi": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string"
        },
        "step": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "visible": {
          "type": "boolean"
        },
        "multiline": {
          "type": "boolean"
        },
        "editor": {
          "enum": ["font_family"]
        },
        "enum_variants": {
          "type": "object",
          "minProperties": 1,
          "patternProperties": {
            "^[0-9]+$": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scene_bindable": {
          "type": "boolean",
          "default": true
        },
        "editable": {
          "type": "boolean",
          "default": true
        },
        "animatable": {
          "type": "boolean",
          "default": false
        },
        "constraints": {
          "$ref": "#/$defs/numericConstraints"
        },
        "ui": {
          "$ref": "#/$defs/scalarUi"
        }
      }
    },
    "propertyValue": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "propertyNames": {
        "enum": ["f32", "i32", "u32", "enum", "bool", "tuple", "color", "string", "array"]
      }
    }
  }
}
